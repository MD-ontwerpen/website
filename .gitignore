# OS cruft
Thumbs.db
desktop.ini
.DS_Store

# Editor
.vscode/
.idea/
*.swp

# Local preview helper (Windows)
*.log

# Print-resolution logo originals (CMYK, ~2.6 MB) - source files, not for the
# web. assets/img/logo.svg is traced from them and is what the site loads.
assets/img/logo*.jpg
assets/img/logo*.jpeg
assets/img/logo*.psd
assets/img/logo*.ai

# Version snapshots and working folders. `website/` is what GitHub Pages
# publishes, so a committed snapshot would put a duplicate of every page at
# md-ontwerpen.nl/version%201/.
version */

# Bytecode from the build scripts
__pycache__/
